# =============================================================================
# TrendRadar AI — Environment Variables (.env.example)
# Copy to `.env` for local development or configure in Vercel Project Settings.
# Never commit actual secrets or API keys to version control.
# =============================================================================

# --- Google Gemini AI (Server-Only, Required for Live AI Analysis) -----------
# Used by /api/trends/analyze-and-create, /api/trends/ingest-official-feed,
# /api/trends/:id/reanalyze, and /api/recommendations/generate
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# --- PostgreSQL Database (Server-Only, Recommended for Production) -----------
# Standard PostgreSQL connection URI (Neon, Supabase, Vercel Postgres, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/trendradar?sslmode=require"
# Optional TLS mode override: require | no-verify | disable
DATABASE_SSL="require"
# Optional pool size (default: 10)
DATABASE_POOL_MAX="10"

# Alternative Discrete PostgreSQL Variables (Cloud SQL / Legacy Compatibility)
SQL_HOST=""
SQL_DB_NAME="postgres"
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# --- Firebase Admin Auth Verification (Server-Only) --------------------------
# Defaults to projectId in firebase-applet-config.json ("stunning-casing-qpz3c")
FIREBASE_PROJECT_ID="stunning-casing-qpz3c"
# Optional Service Account credentials (not required for verifyIdToken, which uses Google public keys)
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- Firebase Web Client (Public Build-Time Overrides, Optional) -------------
# Falls back automatically to firebase-applet-config.json if omitted
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Application Metadata ----------------------------------------------------
APP_URL="https://trendradar-ai.vercel.app"
